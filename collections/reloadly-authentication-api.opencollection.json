{
  "opencollection": "1.0.0",
  "info": {
    "name": "Reloadly Airtime Authentication API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Authentication",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Access Token",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://topups.reloadly.com/oauth/token",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Exchange your client credentials for an OAuth 2.0 bearer access token for the Airtime API. Set audience to https://topups.reloadly.com."
        }
      ]
    }
  ],
  "bundled": true
}