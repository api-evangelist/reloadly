{
  "opencollection": "1.0.0",
  "info": {
    "name": "Reloadly Airtime Authentication Balance API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Balance",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Account Balance",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://topups.reloadly.com/accounts/balance"
          },
          "docs": "Retrieve the current balance of your Reloadly account for airtime top-ups."
        }
      ]
    }
  ],
  "bundled": true
}