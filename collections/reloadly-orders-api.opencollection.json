{
  "opencollection": "1.0.0",
  "info": {
    "name": "Reloadly Airtime Authentication Orders API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Orders",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Place Order",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://topups.reloadly.com/orders",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Place a gift card order for a specific product and denomination. Successful orders return an order object with the gift card code, PIN, and redemption instructions. Orders are fulfilled in real-time."
        },
        {
          "info": {
            "name": "Get Order",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://topups.reloadly.com/orders/:orderId",
            "params": [
              {
                "name": "orderId",
                "value": "",
                "type": "path",
                "description": "Unique identifier of the order"
              }
            ]
          },
          "docs": "Retrieve the details of a specific gift card order including the gift card code, PIN, redemption instructions, and order status."
        }
      ]
    }
  ],
  "bundled": true
}